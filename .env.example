# Leave GEMINI_API_KEY empty for demo mode (photo checks are simulated and labelled as such).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Backup models, tried in order when the main one is out of quota or overloaded (comma separated; empty for none)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Demo tools: fake location, forced weather, reset. Turn on for demos and walk tests, off for a public deployment.
DEV_TOOLS=0
# Key for the review queue at /admin (leave empty to disable it)
ADMIN_KEY=
# Set to 1 to use simulated photo checks even when a Gemini key is present
FORCE_MOCK_VALIDATOR=0
DATA_DIR=./data
# Optional overrides
# AOI_BBOX=-76.645,39.310,-76.595,39.350
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# PHOTO_RETENTION_DAYS=14
# Days before the app rebuilds its own satellite snapshot from fresh Sentinel-2 and Landsat scenes (0 turns it off)
# SATELLITE_REFRESH_DAYS=14
