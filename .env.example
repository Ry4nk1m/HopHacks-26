# Leave GEMINI_API_KEY empty for demo mode (photo checks are simulated and labelled as such).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Demo tools: fake location, forced weather, reset. Turn on for demos and walk tests, off for a public deployment.
DEV_TOOLS=0
# Key for the review queue at /admin (leave empty to disable it)
ADMIN_KEY=
# Set to 1 to use simulated photo checks even when a Gemini key is present
FORCE_MOCK_VALIDATOR=0
DATA_DIR=./data
# Optional overrides
# AOI_BBOX=-76.645,39.310,-76.595,39.350
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# PHOTO_RETENTION_DAYS=14
